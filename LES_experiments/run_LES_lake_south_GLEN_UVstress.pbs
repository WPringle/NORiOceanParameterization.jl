#!/bin/bash
#PBS -N LES_lake_south_GLEN_UVstress
#PBS -A COMPASS-GLM
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
###PBS -q preemptable
#PBS -q debug
#PBS -o logs/LES_lake_south_GLEN_UVstress.out
#PBS -e logs/LES_lake_south_GLEN_UVstress.err

cd ${PBS_O_WORKDIR}
mkdir -p logs

# Proxy settings for any package downloads on compute nodes
export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"

# Julia setup
JULIA=/soft/applications/julia/julia_binaries/julia-1.10/bin/julia
PROJECT_DIR=/lus/eagle/projects/COMPASS-GLM/wpringle/Lake_Julia_Runs/V1_lake_column_model_LES_vs_TURB/NORiOceanParameterization.jl

# LES scripts run in the standalone les_env (current CUDA.jl for the CUDA-13 driver
# A100 nodes); the main project's Lux pin caps CUDA at 5.5.2.  Build it once with
# run_setup_les_env.pbs.
LES_ENV=${PROJECT_DIR}/training/les_env

# Let CUDA.jl use its own artifact-based runtime
export JULIA_LOAD_PATH="${LES_ENV}:@stdlib"

# Output directory
OUTPUT_DIR=${PROJECT_DIR}/data/LES_output/southern_mooring_GLEN
mkdir -p ${OUTPUT_DIR}

# Instantiate project dependencies once before launching experiments
#${JULIA} --project=${PROJECT_DIR} -e 'using Pkg; Pkg.instantiate()'

#####
##### Southern mooring, directional (UV-stress), default closure (none):
#####   2 winters × 2 forcing sources, one case per GPU.
#####     GPU 0 : winter 2010, direct
#####     GPU 1 : winter 2010, coare_wind
#####     GPU 2 : winter 2011, direct
#####     GPU 3 : winter 2011, coare_wind
##### Lz is auto (2010→380 m, 2011→384 m) and the initial condition is the
##### observed Southern Mooring profile (2010 dep lifted up 20 m).
#####

SCRIPT=${PROJECT_DIR}/training/LES_lake_superior_southern_GLEN_UVstress_gpu.jl
COMMON_ARGS="--sim_days 60 --file_location ${OUTPUT_DIR}"

CUDA_VISIBLE_DEVICES=0 ${JULIA} --project=${LES_ENV} ${SCRIPT} \
    2010 --forcing_source direct     ${COMMON_ARGS} \
    > logs/LES_lake_south_GLEN_UVstress_direct_2010.log 2>&1 &

CUDA_VISIBLE_DEVICES=1 ${JULIA} --project=${LES_ENV} ${SCRIPT} \
    2010 --forcing_source coare_wind ${COMMON_ARGS} \
    > logs/LES_lake_south_GLEN_UVstress_coare_wind_2010.log 2>&1 &

CUDA_VISIBLE_DEVICES=2 ${JULIA} --project=${LES_ENV} ${SCRIPT} \
    2011 --forcing_source direct     ${COMMON_ARGS} \
    > logs/LES_lake_south_GLEN_UVstress_direct_2011.log 2>&1 &

CUDA_VISIBLE_DEVICES=3 ${JULIA} --project=${LES_ENV} ${SCRIPT} \
    2011 --forcing_source coare_wind ${COMMON_ARGS} \
    > logs/LES_lake_south_GLEN_UVstress_coare_wind_2011.log 2>&1 &

echo "Southern mooring GLEN-forced (UVstress, closure=none): 2 winters × 2 sources launched, waiting..."
wait
echo "All experiments finished."
