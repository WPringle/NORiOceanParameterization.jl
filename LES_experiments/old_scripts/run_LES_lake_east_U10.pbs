#!/bin/bash
#PBS -N LES_lake_east_U10
#PBS -A SAFS
#PBS -l select=1
#PBS -l walltime=18:00:00
#PBS -l filesystems=home:eagle
#PBS -q preemptable
#PBS -o logs/LES_lake_east_U10.out
#PBS -e logs/LES_lake_east_U10.err

cd ${PBS_O_WORKDIR}
mkdir -p logs

# Proxy settings for any package downloads on compute nodes
export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"

# Julia setup
JULIA=/soft/applications/julia/julia_binaries/julia-1.10/bin/julia
PROJECT_DIR=/lus/eagle/projects/COMPASS-GLM/wpringle/Lake_Julia_Runs/V1_lake_column_model_LES_vs_TURB/NORiOceanParameterization.jl

# Let CUDA.jl use its own artifact-based runtime
export JULIA_LOAD_PATH="${PROJECT_DIR}:@stdlib"

# Output directory
OUTPUT_DIR=${PROJECT_DIR}/data/LES_output/eastern_mooring
mkdir -p ${OUTPUT_DIR}

SCRIPT=${PROJECT_DIR}/training/LES_lake_superior_gpu.jl
COMMON_ARGS="--T_insitu 4.0 --Lz 212 --stop_time 60 --file_location ${OUTPUT_DIR}"

#####
##### Eastern mooring (Lz=212m), U=10 m/s, 3 cooling rates (one per GPU)
#####

CUDA_VISIBLE_DEVICES=0 ${JULIA} --project=${PROJECT_DIR} ${SCRIPT} \
    --U_wind 10 --Q_mean 150 ${COMMON_ARGS} \
    > logs/LES_lake_east_U10_QT150.log 2>&1 &

CUDA_VISIBLE_DEVICES=1 ${JULIA} --project=${PROJECT_DIR} ${SCRIPT} \
    --U_wind 10 --Q_mean 250 ${COMMON_ARGS} \
    > logs/LES_lake_east_U10_QT250.log 2>&1 &

CUDA_VISIBLE_DEVICES=2 ${JULIA} --project=${PROJECT_DIR} ${SCRIPT} \
    --U_wind 10 --Q_mean 350 ${COMMON_ARGS} \
    > logs/LES_lake_east_U10_QT350.log 2>&1 &

echo "Eastern mooring U=10 m/s: 3 experiments launched, waiting..."
wait
echo "All experiments finished."
