#!/bin/bash
#PBS -N lake_superior_southern_mooring_GLEN_forced_UVstress_EOSteos10cabbeling
#PBS -A HSOFS_Ensemble
#PBS -q compute
#PBS -l select=1:ncpus=128
#PBS -l walltime=1:00:00
#PBS -o logs/TURB_southern_mooring_GLEN_forced_UVstress_EOSteos10cabbeling.out
#PBS -e logs/TURB_southern_mooring_GLEN_forced_UVstress_EOSteos10cabbeling.err
#PBS -j oe

set -euo pipefail

# ── Environment ───────────────────────────────────────────────────────────────
export PATH="$HOME/.juliaup/bin:$PATH"

cd "$PBS_O_WORKDIR"

# ── Logging ───────────────────────────────────────────────────────────────────
mkdir -p logs

echo "============================================"
echo "Job ID       : $PBS_JOBID"
echo "Job name     : $PBS_JOBNAME"
echo "Submit dir   : $PBS_O_WORKDIR"
echo "Node         : $(hostname)"
echo "Start time   : $(date)"
echo "Julia version: $(julia +1.10 --version)"
echo "============================================"

# ── Run simulations in parallel, throttled to MAX_JOBS at a time ───────────────
# Fixed EOS = teos10cabbeling (full TEOS-10 equation of state evaluated at Z=0
# everywhere — exact cabbeling curve, no thermobaricity, no polynomial-fit residual).
# Only the k-epsilon closure family is run here (kepsilon, kepsilon_Rist035) — CATKE
# variants are intentionally excluded from this submission.
# Each Julia/Oceananigans process needs ~2.5 GB RAM; MAX_JOBS caps concurrency so
# peak RAM stays well under 128 GB (2 years × 2 closures × 2 sources = 8 jobs here,
# so this batch launches all at once regardless).
SCRIPT="experiments/lake_superior_southern_mooring_GLEN_forced_UVstress_EOS-cabbeling.jl"
EOS="teos10cabbeling"
MAX_JOBS=32

STATUS=0
for year in 2010 2011; do
    for closure in kepsilon kepsilon_Rist035; do
        for source in direct coare_wind; do
            # Throttle: wait for a slot to free up before launching the next job.
            while (( $(jobs -rp | wc -l) >= MAX_JOBS )); do
                wait -n || STATUS=$?
            done
            logfile="logs/southern_mooring_GLEN_forced_UVstress_EOS${EOS}_winter${year}_${closure}_${source}.log"
            echo "Launching: winter=${year} closure=${closure} source=${source} eos=${EOS} → $logfile"
            julia +1.10 --project=. --threads=1 "$SCRIPT" "$year" "$closure" "$source" "$EOS" \
                > "$logfile" 2>&1 &
        done
    done
done

# Wait for the remaining background jobs and collect exit codes
while (( $(jobs -rp | wc -l) > 0 )); do
    wait -n || STATUS=$?
done

echo "============================================"
echo "End time : $(date)"
if [[ $STATUS -ne 0 ]]; then
    echo "WARNING: one or more simulations exited with a non-zero status."
    exit $STATUS
fi
echo "All simulations complete."
