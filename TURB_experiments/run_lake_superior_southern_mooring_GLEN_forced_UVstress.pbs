#!/bin/bash
#PBS -N lake_superior_southern_mooring_GLEN_forced_UVstress
#PBS -A HSOFS_Ensemble
#PBS -q compute
#PBS -l select=1:ncpus=128
#PBS -l walltime=1:00:00
#PBS -o logs/TURB_southern_mooring_GLEN_forced_UVstress.out
#PBS -e logs/TURB_southern_mooring_GLEN_forced_UVstress.err
#PBS -j oe

set -euo pipefail

# ── Environment ───────────────────────────────────────────────────────────────
export PATH="$HOME/.juliaup/bin:$PATH"

cd "$PBS_O_WORKDIR"

# ── Logging ───────────────────────────────────────────────────────────────────
mkdir -p logs

echo "============================================"
echo "Job ID       : $PBS_JOBID"
echo "Job name     : $PBS_JOBNAME"
echo "Submit dir   : $PBS_O_WORKDIR"
echo "Node         : $(hostname)"
echo "Start time   : $(date)"
echo "Julia version: $(julia +1.10 --version)"
echo "============================================"

# ── Run simulations in parallel, throttled to MAX_JOBS at a time ───────────────
# Directional (UV-stress) variant: surface momentum flux split into x/y from the
# measured wind_direction.  Each Julia/Oceananigans process needs ~2.5 GB RAM.
# Launching all combinations at once (e.g. 2 years × 4 closures × 3 sources = 24)
# overcommits the node's memory, which makes JLD2's memory-mapped writes fail with
# SIGBUS (bus error) and corrupt output files.  Cap concurrency so peak RAM stays
# well under 128 GB.
SCRIPT="experiments/lake_superior_southern_mooring_GLEN_forced_UVstress.jl"
MAX_JOBS=32    # verified safe (well under 32 × 2.5 GB ≈ 80 GB peak); lower if you see SIGBUS / corrupt files

# Winter year(s): only 2010 and 2011 are in the southern mooring start-date CSV
# (also the only winters with valid Southern Mooring Tw for coare_wind_southern).
# Turbulence closure(s): kepsilon | kepsilon_Rist035 | CATKE | CATKE_highRi.
# Forcing source(s): "direct" (measured EC fluxes), "coare_wind" (momentum/SHF/LHF
# re-derived from wind via the COARE bulk algorithm, Eastern-Mooring Tw), and
# "coare_wind_southern" (same COARE algorithm, but driven by the Southern
# Mooring's own Tw instead — a sensitivity check on the mooring surface
# temperature; requires the "_wSM" gap-filled input file, see the .jl script).
STATUS=0
for year in 2010 2011; do
    #for closure in kepsilon kepsilon_Rist035 CATKE; do # CATKE_highRi; do
    for closure in kepsilon; do
        #for source in direct coare_wind coare_wind_southern; do
        for source in coare_wind_southern; do
            # Throttle: wait for a slot to free up before launching the next job.
            while (( $(jobs -rp | wc -l) >= MAX_JOBS )); do
                wait -n || STATUS=$?
            done
            logfile="logs/southern_mooring_GLEN_forced_UVstress_winter${year}_${closure}_${source}.log"
            echo "Launching: winter=${year} closure=${closure} source=${source} → $logfile"
            julia +1.10 --project=. --threads=1 "$SCRIPT" "$year" "$closure" "$source" \
                > "$logfile" 2>&1 &
        done
    done
done

# Wait for the remaining background jobs and collect exit codes
while (( $(jobs -rp | wc -l) > 0 )); do
    wait -n || STATUS=$?
done

echo "============================================"
echo "End time : $(date)"
if [[ $STATUS -ne 0 ]]; then
    echo "WARNING: one or more simulations exited with a non-zero status."
    exit $STATUS
fi
echo "All simulations complete."
