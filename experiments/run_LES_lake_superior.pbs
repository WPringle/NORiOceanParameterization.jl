#!/bin/bash
#PBS -N LES_lake_superior
#PBS -A Hydro-model
#PBS -q compute
#PBS -l select=4:ncpus=128
#PBS -l walltime=24:00:00
#PBS -o logs/LES_lake_superior.out
#PBS -e logs/LES_lake_superior.err
#PBS -j oe

set -euo pipefail

# ── Environment ───────────────────────────────────────────────────────────────
export PATH="$HOME/.juliaup/bin:$PATH"

cd "$PBS_O_WORKDIR"
mkdir -p logs data/LES

echo "============================================"
echo "Job ID       : $PBS_JOBID"
echo "Job name     : $PBS_JOBNAME"
echo "Submit dir   : $PBS_O_WORKDIR"
echo "Node         : $(hostname)"
echo "Start time   : $(date)"
echo "Julia version: $(julia +1.10 --version)"
echo "============================================"

# ── Use Julia's bundled MPI (avoids system MPI vs. artifact library conflicts) ──
# HDF5_jll and NCDatasets link to the bundled OpenMPI Fortran interface
# (libmpi_mpifh.so) regardless of MPIPreferences. Using the bundled mpiexec
# ensures all components use the same MPI library and artifacts load cleanly.
julia +1.10 --project=. -e "
    using MPIPreferences
    MPIPreferences.use_jll_binary()
    @info \"MPI backend set to JLL (bundled MPICH)\"
"

# Get just the binary path from Julia's bundled mpiexec Cmd object
JULIA_MPIEXEC=$(julia +1.10 --project=. -e "using MPI; print(MPI.mpiexec().exec[1])")
JULIA_BIN=$(which julia)
echo "Bundled mpiexec : ${JULIA_MPIEXEC}"
echo "Julia binary    : ${JULIA_BIN}"

# ── Distributed LES parameters ───────────────────────────────────────────────
# Grid: 92 × 92 × 92 (Lx=Ly=Lz=184 m, 2 m isotropic); Ry=2 divides Nz=92 ✓
# Hybrid MPI+threads: Rx=2 × Ry=2 = 4 MPI ranks (1 per node), 128 threads each.
# 4 nodes × 128 cores = 512 cores total.
# ~2.1M total cells / 4 ranks ≈ 524288 cells/rank.
SCRIPT="experiments/LES_lake_superior.jl"
N_RANKS=4
N_THREADS=128

echo "Launching LES: ${N_RANKS} MPI ranks, 1 thread each (1 node × 128 cores)"

# -genvall passes the full PBS job environment to every worker process,
# so SSH-spawned ranks see the correct PATH, JULIA_DEPOT_PATH, etc.
# Use the absolute julia path so workers find the right binary.
"${JULIA_MPIEXEC}" -n ${N_RANKS} -genvall \
    "${JULIA_BIN}" +1.10 --project="${PBS_O_WORKDIR}" --threads=${N_THREADS} \
    "${PBS_O_WORKDIR}/${SCRIPT}" \
    > logs/LES_lake_superior_run.log 2>&1

echo "============================================"
echo "End time : $(date)"
echo "LES simulation complete."
echo "============================================"
