#!/bin/bash
#PBS -N lake_superior_western_mooring
#PBS -A SpaceCoast_RESCUE
#PBS -q compute
#PBS -l select=1:ncpus=128:mem=128gb
#PBS -l walltime=1:00:00
#PBS -o logs/lake_superior_western_mooring.out
#PBS -e logs/lake_superior_western_mooring.err
#PBS -j oe

set -euo pipefail

# ── Environment ──────────────────────────────────────────────────────────────
export PATH="$HOME/.juliaup/bin:$PATH"

cd "$PBS_O_WORKDIR"

# ── Logging ──────────────────────────────────────────────────────────────────
mkdir -p logs

echo "============================================"
echo "Job ID       : $PBS_JOBID"
echo "Job name     : $PBS_JOBNAME"
echo "Submit dir   : $PBS_O_WORKDIR"
echo "Node         : $(hostname)"
echo "Start time   : $(date)"
echo "Julia version: $(julia +1.10 --version)"
echo "============================================"

# ── Run all 27 simulations in parallel (one process per combination) ─────────
# 3 wind cases × 3 closures × 3 QT_mean = 27 processes; 128-core node fits all.
SCRIPT="experiments/lake_superior_western_mooring_column_model.jl"

PIDS=()
for qt in 150 200 250; do
    for wind in U4ms U6ms U8ms; do
        for closure in kepsilon CATKE NN; do
            logfile="logs/lake_superior_${wind}_${closure}_QT${qt}.log"
            echo "Launching: $wind $closure QT=${qt} → $logfile"
            julia +1.10 --project=. --threads=1 "$SCRIPT" "$wind" "$closure" "$qt" \
                > "$logfile" 2>&1 &
            PIDS+=($!)
        done
    done
done

# Wait for all background jobs and collect exit codes
STATUS=0
for pid in "${PIDS[@]}"; do
    wait "$pid" || STATUS=$?
done

echo "============================================"
echo "End time : $(date)"
if [[ $STATUS -ne 0 ]]; then
    echo "WARNING: one or more simulations exited with a non-zero status."
    exit $STATUS
fi
echo "All 27 simulations complete. Running plot script..."

julia +1.10 --project=. figure_scripts/plot_lake_superior_western_mooring.jl \
    >> logs/lake_superior_western_mooring.out 2>&1

echo "Done."
